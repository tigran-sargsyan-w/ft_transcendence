POSTGRES_USER=transcendence
POSTGRES_PASSWORD=change_me
POSTGRES_DB=transcendence

# Compose passes COLLECTOR_URL=http://collector:3001 directly to Nest.
# For host-local Nest, use http://localhost:3001 instead.
COLLECTOR_URL=http://collector:3001

# Backend sessions (ADR 0002). Defaults: 168 hours, secure cookie.
# COOKIE_SECURE=false only for local development over plain HTTP.
SESSION_TTL_HOURS=168
COOKIE_SECURE=true

# Browser-facing origin for authenticated Socket.IO connections.
# Compose passes this variable to Nest, with the local default below.
# Override it for another HTTPS hostname or port; match the exact origin.
APP_ORIGIN=https://transcendence.test:8443

# Nest → Graph Engine (Compose service URL). Host-local Nest: http://localhost:8000
GRAPH_ENGINE_URL=http://graph-engine:8000
