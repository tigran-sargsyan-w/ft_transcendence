POSTGRES_USER=transcendence
POSTGRES_PASSWORD=change_me
POSTGRES_DB=transcendence

# Where Nest reads the Docker collector to build the topology. Unset: no
# topology is built. The backend service must be given it (compose.yml).
# Compose network: http://collector:3001. Nest on the host: http://localhost:3001
COLLECTOR_URL=http://collector:3001

# Backend sessions (ADR 0002). Defaults: 168 hours, secure cookie.
# COOKIE_SECURE=false only for local development over plain HTTP.
SESSION_TTL_HOURS=168
COOKIE_SECURE=true

# Where the browser reaches the application. The realtime gateway refuses a
# Socket.IO handshake whose Origin header is anything else, and every handshake
# that has an Origin while this is unset. The backend service must be given it
# (compose.yml). Local setup: https://transcendence.test:8443
APP_ORIGIN=https://transcendence.test:8443

# Nest → Graph Engine (Compose service URL). Host-local Nest: http://localhost:8000
GRAPH_ENGINE_URL=http://graph-engine:8000
