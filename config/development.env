# Public development configuration; never put credentials here.
# Existing deployments require a reviewed cutover before changing public endpoints.

# ==========================================
# Application endpoints
# ==========================================

DEV_DOMAIN=localhost
DEV_HTTP_PORT=8080
DEV_HTTPS_PORT=8443

# ==========================================
# Operator interfaces
# ==========================================

DEV_VAULT_UI_PORT=8200
DEV_PRISMA_UI_PORT=5555

# ==========================================
# Authentication and sessions
# ==========================================

SESSION_TTL_HOURS=168
COOKIE_SECURE=true
